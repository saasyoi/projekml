# Copy this file to .env and fill in real values. Never commit .env.

# Google Gemini API key (used for image OCR/analysis, text triage, and chatbot replies)
GEMINI_API_KEY=

# Telegram bot token (only required if running bot.py)
TELEGRAM_BOT_TOKEN=

# Comma-separated list of allowed cross-origin domains for the API.
# Leave empty for same-origin deployment (default: frontend served by FastAPI itself).
# Example: https://familysecure.example.com,https://app.familysecure.example.com
ALLOWED_ORIGINS=

# Secret used to sign login session tokens (JWT). REQUIRED in production —
# if unset, a random key is generated at startup and all sessions are lost on restart.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Database connection string (SQLAlchemy). Defaults to a local SQLite file if unset —
# fine for development. For production, point to a managed PostgreSQL instance, e.g.:
# postgresql+psycopg2://user:password@host:5432/dbname
DATABASE_URL=

# Whether the login session cookie requires HTTPS. Keep "true" in production.
# Set to "false" only for local development over plain http://localhost.
COOKIE_SECURE=true
